{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node -e \"try{require('fs').unlinkSync('public/hot')}catch(e){}\" && vite build",
        "dev": "vite",
        "dev:assets": "node -e \"try{require('fs').unlinkSync('public/hot')}catch(e){}\" && vite build --watch",
        "dev:app": "concurrently -k -n backend,assets \"php artisan serve --host=127.0.0.1 --port=3458\" \"npm run dev:assets\"",
        "serve:shopify": "php artisan serve --host=127.0.0.1 --port=3458",
        "dev:backend": "php artisan serve --host=127.0.0.1 --port=3458",
        "shopify": "shopify.cmd",
        "devs": "shopify.cmd app dev",
        "dev:shopify": "shopify.cmd app dev --config dev",
        "dev:shopify:ngrok": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-shopify-ngrok.ps1",
        "dev:shopify:localhost": "shopify.cmd app dev --use-localhost --config dev",
        "dev:shopify:clean": "shopify.cmd app dev clean --config dev",
        "info": "shopify.cmd app info",
        "generate": "shopify.cmd app generate",
        "deploy": "shopify.cmd app deploy"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.20",
        "axios": "^1.7.4",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^1.2.0",
        "postcss": "^8.4.47",
        "tailwindcss": "^3.4.13",
        "vite": "^6.0.11"
    },
    "dependencies": {
        "@shopify/app-bridge-react": "^4.1.8",
        "@shopify/polaris": "^13.9.5",
        "@shopify/shopify_function": "~2.0.0",
        "@shopify/ui-extensions": "2025.7.3",
        "@shopify/ui-extensions-react": "2025.7.3",
        "@vitejs/plugin-react": "^4.3.4",
        "preact": "^10.28.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-reconciler": "0.29.0",
        "react-router-dom": "^7.4.0",
        "react-switch": "^7.1.0"
    }
}
